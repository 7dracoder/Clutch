# Never commit real credentials. Rotate any credential shared in chat.
BASETEN_API_KEY=
BASETEN_MODEL=moonshotai/Kimi-K2.6

# Local live screen-observation worker.
NEXT_PUBLIC_VISION_WS_URL=ws://127.0.0.1:8765/ws
VISION_WORKER_HTTP_URL=http://127.0.0.1:8765
VISION_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VISION_SPORT=soccer
# Use opencv for the lightweight fallback or soccer-rfdetr for the optional model.
VISION_DETECTOR=opencv
SOCCER_MODEL_PATH=services/vision/models/rfdetr-soccernet/weights/checkpoint_best_regular.pth
SOCCER_DEVICE=cuda

# Rho sandbox accepts any non-empty bearer token.
# With token=sandbox, Clutch serves a break-even demo ledger (many pending txs).
RHO_API_TOKEN=sandbox
RHO_API_BASE_URL=https://rhoapi-sandbox.rho.co/api/v1

# Server-side only. Do not expose these to the browser.
TAVILY_API_KEY=
# API-Football — live soccer score + events only (https://dashboard.api-football.com).
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
ELEVENLABS_AGENT_ID=
ELEVENLABS_PERSONAL_AGENT_ID=
ELEVENLABS_API_KEY=

# Real Stan product URL used by Creator Studio.
NEXT_PUBLIC_STAN_PRODUCT_URL=
